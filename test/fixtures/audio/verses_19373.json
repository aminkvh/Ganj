[{"verseOrder":0,"verseText":"شمارهٔ ۴۵","audioStartMilliseconds":0},{"verseOrder":1,"verseText":"ساقی اگرت هوای ما هی،","audioStartMilliseconds":27750},{"verseOrder":2,"verseText":"جز باده مباد نزد ما هی!","audioStartMilliseconds":31950},{"verseOrder":3,"verseText":"سجّاده و خرقه در خرابات","audioStartMilliseconds":40800},{"verseOrder":4,"verseText":"بفروش و بیار جرعه ای می","audioStartMilliseconds":43800},{"verseOrder":5,"verseText":"گر زنده دلی شنو ز مستان","audioStartMilliseconds":55350},{"verseOrder":6,"verseText":"در گلشن جان ندای یا حی","audioStartMilliseconds":58350},{"verseOrder":9,"verseText":"اسرار دل است در ره عشق","audioStartMilliseconds":69300},{"verseOrder":10,"verseText":"آواز سماع و نالهٔ نی","audioStartMilliseconds":73650},{"verseOrder":11,"verseText":"یک مفلس پاک باز در عشق","audioStartMilliseconds":83400},{"verseOrder":12,"verseText":"بهتر ز هزار حاتم طی","audioStartMilliseconds":87450},{"verseOrder":13,"verseText":"سلطان صفت آن بت پری روی","audioStartMilliseconds":99900},{"verseOrder":14,"verseText":"می آمد و خلق شهر در پی","audioStartMilliseconds":103950},{"verseOrder":15,"verseText":"مردم نگران به روی خوبش","audioStartMilliseconds":112200},{"verseOrder":16,"verseText":"وز شرم گرفته عارضش خوی","audioStartMilliseconds":117900},{"verseOrder":17,"verseText":"حافظ ز غم تو چند نالد","audioStartMilliseconds":128250},{"verseOrder":18,"verseText":"آخر من دلشکسته تا کی","audioStartMilliseconds":134250}]